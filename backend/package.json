{
  "name": "skillmatch-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SkillMatch backend: Express + PostgreSQL",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
