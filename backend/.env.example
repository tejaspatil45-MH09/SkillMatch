NODE_ENV=development
PORT=5000
# Postgres from docker-compose.yml
DATABASE_URL=postgres://skillmatch:skillmatch@localhost:5432/skillmatch
# A throwaway database used ONLY by `npm test` (it is wiped on every run; the name must contain "test")
TEST_DATABASE_URL=postgres://skillmatch:skillmatch@localhost:5432/skillmatch_test
# Required in production, at least 32 random characters (used from Phase 2 for sessions)
SESSION_SECRET=
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
APP_URL=http://localhost:5173
# Leave SMTP_HOST empty in development: reset links are printed to the server log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SkillMatch <no-reply@skillmatch.local>
